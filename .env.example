# ── StonksPadVaultFactory deployment ─────────────────────────────────────────
# Required by script/{testnet,mainnet}/bnb/DeployStonksPadVaultFactory.s.sol
PLATFORM_ADMIN=0x0000000000000000000000000000000000000000
KEEPER=0x0000000000000000000000000000000000000000
PLATFORM_TREASURY=0x0000000000000000000000000000000000000000
# Treasury wallets (80% STONKS buy&burn is on-chain; these two get 10% each)
NFT_WALLET=0x0000000000000000000000000000000000000000
PLATFORM_WALLET=0x0000000000000000000000000000000000000000
# Optional: buy&burn token (mainnet default STONKS 0xc9d8…7777, testnet default CAKE)
# STONKS=0xc9d825E83AadA475bD4d38C8ca984eD746277777
# Optional: vault platform fee in bps of net revenue (default 1000; mainnet target 1111 = 10% of gross at Flap's 10% fee; max 1200)
# PLATFORM_FEE_BPS=1111
# Optional: override the chain's default Chainlink BNB/USD feed
# BNB_USD_FEED=0x2514895c72f50D8bd4B4F9b1110F0D6bD2c97526

